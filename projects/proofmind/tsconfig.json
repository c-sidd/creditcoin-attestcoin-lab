{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["mocha"]
  },
  "include": ["worker/src/**/*", "worker/tests/**/*", "backend/src/**/*", "backend/tests/**/*"]
}
